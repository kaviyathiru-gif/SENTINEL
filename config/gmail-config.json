{
  "smtp_settings": {
    "service": "gmail",
    "host": "smtp.gmail.com",
    "port": 465,
    "secure": true,
    "auth": {
      "type": "OAuth2",
      "user": "admin.soc@google-pixel.org",
      "clientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "refreshToken": "YOUR_GOOGLE_REFRESH_TOKEN"
    },
    "connection_timeout_ms": 10000,
    "max_retries": 3
  },
  "default_sender": {
    "name": "SENTINEL AI Defense System",
    "address": "no-reply@sentinel-secops.org"
  },
  "automation_rules": {
    "dispatch_on_critical_attack": true,
    "dispatch_daily_report": true,
    "dispatch_weekly_report": true,
    "dispatch_monthly_report": true,
    "dispatch_yearly_report": true,
    "cron_schedule": "0 0 * * *"
  },
  "email_templates": {
    "periodic_comparison_summary": {
      "subject": "[SENTINEL SEC-OPS] Periodic Security Report (Daily, Weekly, Monthly, Yearly)",
      "body_html": "<div style='background-color:#0a0814; color:#e2e8f0; padding:24px; font-family:sans-serif; border:1px solid #06b6d4; border-radius:12px;'><h2 style='color:#9333ea; margin-top:0;'>SENTINEL THREAT COMPARISON MATRIX</h2><p style='color:#94a3b8; font-size:13px;'>Automated Multi-Period Security Analysis</p><div style='display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:20px 0;'><div style='background:#141026; padding:12px; border-radius:8px; text-align:center;'><div style='font-size:10px; color:#c084fc;'>DAILY</div><div style='font-size:18px; color:#06b6d4; font-weight:bold;'>{{DAILY_COUNT}}</div></div><div style='background:#141026; padding:12px; border-radius:8px; text-align:center;'><div style='font-size:10px; color:#c084fc;'>WEEKLY</div><div style='font-size:18px; color:#06b6d4; font-weight:bold;'>{{WEEKLY_COUNT}}</div></div><div style='background:#141026; padding:12px; border-radius:8px; text-align:center;'><div style='font-size:10px; color:#c084fc;'>MONTHLY</div><div style='font-size:18px; color:#06b6d4; font-weight:bold;'>{{MONTHLY_COUNT}}</div></div><div style='background:#141026; padding:12px; border-radius:8px; text-align:center;'><div style='font-size:10px; color:#c084fc;'>YEARLY</div><div style='font-size:18px; color:#06b6d4; font-weight:bold;'>{{YEARLY_COUNT}}</div></div></div><p style='font-size:13px;'>System Uptime: <strong style='color:#10b981;'>{{UPTIME}}%</strong></p></div></div>"
    }
  }
}
