rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Sentinel Data Collection
    match /sentinelData/{documentId} {
      // Read rules
      allow read: if isAuthenticated() || request.auth == null;
      
      // Write rules
      allow write: if isAuthenticated();
      
      // Create rules
      allow create: if isAuthenticated();
      
      // Update rules
      allow update: if isAuthenticated();
      
      // Delete rules (admin only)
      allow delete: if isAdmin();
    }
    
    // Attack Logs Collection
    match /attackLogs/{logId} {
      allow read: if isAuthenticated() || request.auth == null;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
      
      // Sub-collection for log details
      match /details/{detailId} {
        allow read: if isAuthenticated() || request.auth == null;
        allow write: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }
    
    // ML Models Collection
    match /mlModels/{modelId} {
      allow read: if isAuthenticated() || request.auth == null;
      allow write: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Threat Intelligence Collection
    match /threatIntelligence/{threatId} {
      allow read: if isAuthenticated() || request.auth == null;
      allow write: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
      
      // Sub-collection for threat sources
      match /sources/{sourceId} {
        allow read: if isAuthenticated() || request.auth == null;
        allow write: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
    
    // User Settings Collection
    match /userSettings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }
    
    // Audit Logs Collection (admin only)
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
